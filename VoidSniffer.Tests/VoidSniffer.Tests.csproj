<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>VoidSniffer.Tests</AssemblyName>
    <RootNamespace>VoidSniffer.Tests</RootNamespace>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the already-built application assembly instead of building the
         WinForms project through the .NET SDK toolchain (whose resource task cannot
         host the x86 WinForms build). The solution builds VoidSniffer with MSBuild;
         tests then run against its output. -->
    <Reference Include="VoidSniffer">
      <HintPath>..\VoidSniffer\bin\$(Configuration)\VoidSniffer.exe</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
